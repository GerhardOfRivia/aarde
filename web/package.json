{
  "name": "aarde-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-openapi.mjs && tsc -b && vite build && node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\" && node scripts/copy-docs-licenses.mjs",
    "preview": "vite preview",
    "test": "node scripts/check-openapi.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node tests/viewer.browser.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.1",
    "ol": "^10.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "@apidevtools/swagger-parser": "13.1.0",
    "swagger-ui-dist": "5.33.0"
  }
}
