# Local CLI/server. Compose supplies its internal database connection URL.
AARDE_DATABASE_URL=postgres://aarde:aarde-local@localhost:5432/aarde?sslmode=disable
AARDE_LISTEN_ADDRESS=:8080
AARDE_LOG_LEVEL=info
# Anonymous catalog browsing/search; false requires the startup token.
AARDE_WEB_PUBLIC_READ=false
# Set to none to disable external basemap tiles for every browser.
AARDE_WEB_BASEMAP=osm
# Optional token file override. Its parent directory must be private (0700).
# AARDE_WEB_TOKEN_PATH=/home/aarde/.local/state/aarde/web.token
POSTGRES_DB=aarde
POSTGRES_USER=aarde
# Compose password; change before sharing the deployment. URL-encode special characters in connection URLs.
POSTGRES_PASSWORD=aarde-local

# Whole-image Image Viewer limits (no tiles, preparation jobs, or derivatives).
AARDE_VIEWER_MAX_DIMENSION=4096
AARDE_VIEWER_LAYER_PIXELS=8000000
AARDE_VIEWER_SCENE_PIXELS=24000000
AARDE_VIEWER_CONCURRENT=2
AARDE_VIEWER_TIMEOUT=20s
# Optional scratch directory; defaults to the OS temporary directory.
# AARDE_VIEWER_TEMP_DIR=/tmp
# Optional colon-separated allowed source roots (absolute paths).
# AARDE_VIEWER_SOURCE_ROOTS=/data
